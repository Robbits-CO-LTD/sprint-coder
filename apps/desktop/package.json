{
  "name": "@sprint-coder/desktop",
  "productName": "Sprint Coder",
  "version": "0.2.5",
  "description": "ローカルファーストのAIコーディング・デスクトップアプリ",
  "author": "Sprint Coder contributors",
  "private": true,
  "license": "MIT",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "prepare:desktop": "electron-rebuild -f -w better-sqlite3 && node ../../build-native-safe-fs.mjs",
    "package": "npm run prepare:desktop && electron-forge package",
    "make": "npm run prepare:desktop && electron-forge make",
    "make:windows": "npm run prepare:desktop && electron-forge make --platform=win32 --arch=x64",
    "generate:dmg-background": "node scripts/generate-dmg-background.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sprint-coder/contracts": "*",
    "@sprint-coder/domain": "*",
    "better-sqlite3": "^12.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "lottie-web": "^5.13.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron-forge/shared-types": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.2",
    "@electron/windows-sign": "^1.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "^43.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
