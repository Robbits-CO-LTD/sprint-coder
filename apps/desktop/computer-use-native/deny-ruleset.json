    {
      "class": "C",
      "platforms": ["win32"],
      "when": [
        {
          "signal": "descendantShell",
          "match": "true"
        }
      ]
    },
    {
      "class": "C",
      "platforms": ["win32"],
      "when": [
        {
          "signal": "descendantPseudoConsole",
          "match": "true"
        }
      ]
    },
    {
      "class": "C",
      "platforms": ["win32"],
      "note": "Decision C: unsigned is capped until the Windows approval path exists.",
      "when": [
        {
          "signal": "signature",
          "match": "equals",
