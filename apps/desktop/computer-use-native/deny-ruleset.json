            "mintty.exe",
            "git-bash.exe",
            "git-cmd.exe",
            "alacritty.exe",
            "wezterm*.exe",
            "hyper.exe",
            "tabby.exe",
            "kitty*.exe",
            "conemu*.exe",
            "cmder.exe",
            "warp.exe",
            "putty*.exe",
            "securecrt*.exe",
            "xshell*.exe",
            "mobaxterm*.exe",
            "termius*.exe",
            "winscp*.exe",
            "bvssh*.exe",
            "kitty_portable*.exe"
          ]
        }
      ]
    },
    {
      "class": "W5",
      "platforms": ["win32"],
      "when": [
        {
          "signal": "signerOrganization",
          "match": "equals",
          "values": [
            "teamviewer germany gmbh",
            "anydesk software gmbh",
            "citrix systems, inc.",
            "vmware, inc.",
            "oracle america, inc.",
            "parsec cloud, inc.",
            "realvnc limited",
            "splashtop inc.",
            "logmein, inc.",
            "purslane ltd.",
            "devolutions inc.",
            "royal apps gmbh",
            "mremoteng"
          ]
        }
      ],
      "note": "Remote desktop, VM consoles and remote management by publisher. Provisional publisher strings, to be measured in #777 (item 5); deny-direction only."
    },
    {
      "class": "W5",
      "platforms": ["win32"],
      "when": [
        {
          "signal": "packageFamily",
          "match": "prefix",
          "values": [
            "microsoft.remotedesktop",
            "microsoftcorporationii.windows365",
            "microsoftcorporationii.quickassist"
