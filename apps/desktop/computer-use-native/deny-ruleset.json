            "msrdc*.exe",
            "rustdesk*.exe",
            "teamviewer*.exe",
            "anydesk*.exe",
            "vncviewer*.exe",
            "tvnviewer.exe",
            "parsecd.exe",
            "vmware*.exe",
            "vmplayer.exe",
            "vmconnect.exe",
            "virtualbox*.exe",
            "quickassist.exe",
            "remoting_*.exe",
            "wfica32.exe",
            "cdviewer.exe",
            "remotedesktopmanager*.exe",
            "royalts*.exe",
            "mremoteng*.exe"
          ]
        }
      ]
    },
    {
      "class": "W6",
      "platforms": ["win32"],
      "note": "Outside the install roots (%TEMP%, Downloads) nothing is eligible.",
      "when": [
        {
          "signal": "imageRoot",
          "match": "equals",
          "values": ["temp", "downloads"]
        }
      ]
    },
    {
      "class": "W6",
      "platforms": ["win32"],
      "when": [
        {
          "signal": "requiresAdministrator",
          "match": "true"
        }
      ]
    },
    {
      "class": "W6",
      "platforms": ["win32"],
      "when": [
        {
          "signal": "imageLeaf",
          "match": "glob",
          "values": ["setup*", "*install*", "*update*.exe", "unins*.exe", "msiexec.exe"]
